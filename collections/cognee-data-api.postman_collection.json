          "name": "Add data to a dataset",
          "request": {
            "name": "Add data to a dataset",
            "description": {
              "content": "Add data to a dataset for processing and knowledge graph construction. Accepts files, HTTP URLs (if ALLOW_HTTP_REQUESTS is enabled), or GitHub repository URLs. Either datasetName or datasetId must be provided.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "List of files or URLs to upload"
                },
                {
                  "key": "datasetName",
                  "value": "<string>",
                  "type": "text",
                  "description": "Name of the target dataset"
                },
                {
                  "key": "datasetId",
                  "value": "<uuid>",
                  "type": "text",
                  "description": "UUID of an existing dataset"
                },
                {
                  "key": "node_set",
                  "value": "[\"\"]",
                  "type": "text",
                  "description": "Node identifiers for graph organization and access control"
                },
                {
                  "key": "run_in_background",
                  "value": "false",
                  "type": "text",
                  "description": "Run add pipeline asynchronously"
                }
              ]
            }
          },
