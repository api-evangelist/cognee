          "name": "Search the knowledge graph",
          "request": {
            "name": "Search the knowledge graph",
            "description": {
              "content": "Perform semantic search across the knowledge graph using one of 16 search types including GRAPH_COMPLETION, RAG_COMPLETION, SUMMARIES, CHUNKS, CYPHER, TEMPORAL, AGENTIC_COMPLETION and more. Supports dataset scoping and pagination.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
