                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is in the document?\",\n  \"search_type\": \"<string>\",\n  \"datasets\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"dataset_ids\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"system_prompt\": \"Answer the question using the provided context. Be as brief as possible.\",\n  \"node_name\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"top_k\": 10,\n  \"only_context\": false,\n  \"verbose\": false,\n  \"skills\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"tools\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"max_iter\": \"<integer>\"\n}",
